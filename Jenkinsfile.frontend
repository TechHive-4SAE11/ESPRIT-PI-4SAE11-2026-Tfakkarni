// ============================================================
// Tfakkarni Frontend — CI/CD Pipeline
// Angular 18 Application
// ============================================================

pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Git branch to build (e.g. main, develop, feature/xyz)')
    }

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN      = credentials('sonar-token')
        DOCKER_REGISTRY  = 'tfakkarni'
        SONAR_HOST       = 'http://sonarqube:9000'
        // ⭐ AJOUT : Désactiver les logs inutiles
        CI = 'true'
        NG_CLI_ANALYTICS = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.BRANCH_NAME}"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                echo "✅ Code checked out from branch: ${params.BRANCH_NAME}"
            }
        }

        // ⭐ MODIFICATION : Installer les dépendances de manière plus robuste
        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    script {
                        // Supprimer node_modules et package-lock.json en cas d'échec
                        sh '''
                            rm -rf node_modules package-lock.json
                            npm cache clean --force
                        '''
                        // Installer avec timeout
                        timeout(time: 10, unit: 'MINUTES') {
                            sh 'npm install --legacy-peer-deps'
                        }
                    }
                }
                echo '✅ Dependencies installed'
            }
        }

        // ⭐ MODIFICATION : Tests avec retry et timeout
        stage('Unit Tests') {
            steps {
                dir('frontend') {
                    timeout(time: 15, unit: 'MINUTES') {
                        retry(2) {
                            sh 'npx ng test --watch=false --browsers=ChromeHeadless --code-coverage --no-progress'
                        }
                    }
                }
            }
            post {
                always {
                    junit testResults: 'frontend/test-results/**/*.xml', allowEmptyResults: true
                    echo '✅ Frontend unit tests executed'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            npx sonar-scanner \
                                -Dsonar.host.url=${SONAR_HOST} \
                                -Dsonar.token=${SONAR_TOKEN} \
                                -Dsonar.projectKey=tfakkarni-frontend \
                                -Dsonar.sources=src \
                                -Dsonar.tests=src \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        """
                    }
                }
                echo '✅ SonarQube analysis completed'
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh 'npx ng build --configuration=production --progress=false'
                    }
                }
                echo '✅ Production build completed'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    sh "docker build -f frontend/Dockerfile -t ${baseRepo}:frontend -t ${baseRepo}:frontend-${env.BUILD_NUMBER} ."
                }
                echo '✅ Docker image built'
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    sh """
                        echo ${DOCKER_HUB_CREDS_PSW} | docker login -u ${DOCKER_HUB_CREDS_USR} --password-stdin
                        docker push ${baseRepo}:frontend
                        docker push ${baseRepo}:frontend-${env.BUILD_NUMBER}
                    """
                }
                echo '✅ Docker image pushed'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker-compose -f docker-compose.frontend.yml up -d --remove-orphans'
                echo '✅ Frontend deployed'
            }
        }
    }

    post {
        success {
            echo '🎉 Frontend CI/CD Pipeline completed successfully!'
        }
        failure {
            echo '❌ Frontend CI/CD Pipeline failed. Check logs above.'
        }
        always {
            deleteDir()
        }
    }
}