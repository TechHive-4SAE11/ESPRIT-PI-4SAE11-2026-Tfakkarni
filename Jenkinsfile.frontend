// ============================================================
// Tfakkarni Frontend — CI/CD Pipeline
// Angular 18 Application
// ============================================================

pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN      = credentials('sonar-token')
        SONAR_HOST       = 'http://sonarqube:9000'
    }

    stages {
        // ── Stage 1: Checkout ──
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out"
            }
        }

        // ── Stage 2: Install Dependencies ──
        stage('Install Dependencies') {
            steps {
                retry(3) {
                    dir('frontend') {
                        sh 'npm ci --legacy-peer-deps'
                    }
                }
                echo '✅ Dependencies installed'
            }
        }

        // ── Stage 3: Build Production ──
        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npx ng build --configuration=production'
                }
                echo '✅ Production build completed'
            }
        }

        // ── Stage 4: SonarQube Analysis (non-blocking) ──
        stage('SonarQube Analysis') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    dir('frontend') {
                        withSonarQubeEnv('SonarQube') {
                            sh "npx sonar-scanner -Dsonar.host.url=${SONAR_HOST} -Dsonar.token=${SONAR_TOKEN}"
                        }
                    }
                }
                echo '✅ SonarQube analysis done (non-blocking)'
            }
        }

        // ── Stage 5: Docker Build & Push ──
        stage('Docker Build & Push') {
            steps {
                script {
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    sh "docker login -u ${DOCKER_HUB_CREDS_USR} -p ${DOCKER_HUB_CREDS_PSW}"
                    sh "docker build -f frontend/Dockerfile -t ${baseRepo}:frontend -t ${baseRepo}:frontend-${env.BUILD_NUMBER} ."
                    sh "docker push ${baseRepo}:frontend"
                    sh "docker push ${baseRepo}:frontend-${env.BUILD_NUMBER}"
                }
                echo '✅ Frontend Docker image pushed to Docker Hub'
            }
        }

        // ── Stage 6: Deploy ──
        stage('Deploy') {
            steps {
                sh 'docker-compose -f docker-compose.frontend.yml up -d --remove-orphans'
                echo '✅ Frontend deployed'
            }
        }
    }

    post {
        success {
            echo '🎉 Frontend CI/CD Pipeline completed successfully!'
        }
        failure {
            echo '❌ Frontend CI/CD Pipeline failed. Check logs above.'
        }
        always {
            deleteDir()
        }
    }
}

