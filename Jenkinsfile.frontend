// ============================================================
// Tfakkarni Frontend — CI/CD Pipeline
// Angular 18 Application
// ============================================================

pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'  // Configure in Jenkins > Global Tool Configuration
    }

    environment {
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN      = credentials('sonar-token')
        SONAR_HOST       = 'http://sonarqube:9000'
        KUBE_NAMESPACE   = 'tfakkarni'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out from ${env.GIT_URL} branch ${env.GIT_BRANCH}"
            }
        }

        stage('Install Dependencies') {
            steps {
                retry(3) {
                    dir('frontend') {
                        sh 'pnpm install --frozen-lockfile || npm ci --legacy-peer-deps'
                    }
                }
                echo '✅ Dependencies installed'
            }
        }

        stage('Unit Tests') {
            steps {
                dir('frontend') {
                    sh 'node scripts/set-env.js'
                    sh 'npx ng test --watch=false --browsers=ChromeHeadless --code-coverage'
                }
            }
            post {
                always {
                    echo '✅ Frontend unit tests executed with coverage'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('SonarQube') {
                        sh "npx sonar-scanner -Dsonar.host.url=${SONAR_HOST} -Dsonar.token=${SONAR_TOKEN}"
                    }
                }
                echo '✅ SonarQube analysis completed'
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npx ng build --configuration=production'
                }
                echo '✅ Production build completed'
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    env.IMAGE_REPO = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    env.BUILD_IMAGE = "${env.IMAGE_REPO}:frontend-${env.BUILD_NUMBER}"
                    env.LATEST_IMAGE = "${env.IMAGE_REPO}:frontend"
                    sh "docker build -f frontend/Dockerfile -t ${env.BUILD_IMAGE} -t ${env.LATEST_IMAGE} ."
                }
                echo '✅ Frontend Docker image built'
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    sh 'echo "$DOCKER_HUB_CREDS_PSW" | docker login -u "$DOCKER_HUB_CREDS_USR" --password-stdin'
                    sh "docker push ${env.BUILD_IMAGE}"
                    sh "docker push ${env.LATEST_IMAGE}"
                }
                echo '✅ Frontend Docker image pushed to Docker Hub'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    sh "kubectl -n ${env.KUBE_NAMESPACE} set image deployment/frontend frontend=${env.BUILD_IMAGE}"
                    sh "kubectl -n ${env.KUBE_NAMESPACE} rollout status deployment/frontend --timeout=180s"
                }
                echo "🚀 Frontend deployed to Kubernetes from Docker Hub image ${env.BUILD_IMAGE}"
            }
        }
    }

    post {
        success {
            echo '🎉 Frontend CI/CD Pipeline completed successfully!'
        }
        failure {
            echo '❌ Frontend CI/CD Pipeline failed. Check logs above.'
        }
        always {
            deleteDir()
        }
    }
}
