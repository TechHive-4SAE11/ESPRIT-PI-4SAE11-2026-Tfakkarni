# ============================================================
# Tfakkarni .env file for KillerCoda scenario
# ============================================================
# IMPORTANT: Replace all placeholder values below with your
# actual credentials before running the scenario.
#
# The services connect to cloud-hosted databases (Neon) and
# Keycloak — no local DB or auth server needed.
# ============================================================

# --- Keycloak ---
KEYCLOAK_URL=https://lemur-12.cloud-iam.com/auth
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME

# --- Neon PostgreSQL Databases ---
NEON_USER_DB_URL=jdbc:postgresql://REPLACE_HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_USER_DB_USERNAME=neondb_owner
NEON_USER_DB_PASSWORD=REPLACE_ME

NEON_GAME_DB_URL=jdbc:postgresql://REPLACE_HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_GAME_DB_USERNAME=neondb_owner
NEON_GAME_DB_PASSWORD=REPLACE_ME

NEON_SHARED_DB_URL=jdbc:postgresql://REPLACE_HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_SHARED_DB_USERNAME=neondb_owner
NEON_SHARED_DB_PASSWORD=REPLACE_ME

NEON_MEDICAL_DB_URL=jdbc:postgresql://REPLACE_HOST:5432/neondb?sslmode=require&prepareThreshold=0
NEON_IOT_DB_URL=jdbc:postgresql://REPLACE_HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_IOT_DB_USERNAME=neondb_owner
NEON_IOT_DB_PASSWORD=REPLACE_ME

# --- Redis (Upstash) ---
REDIS_HOST=REPLACE_ME
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME

