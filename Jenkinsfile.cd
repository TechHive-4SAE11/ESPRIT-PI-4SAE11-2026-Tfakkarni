// ============================================================
// Jenkinsfile.cd - Backend service Continuous Deployment
// One Jenkins job per backend service uses this parameterized file.
// CD responsibility: use/pull Docker Hub image produced by CI -> deploy that service to Kubernetes.
// ============================================================

pipeline {
    agent any

    parameters {
        string(name: 'SERVICE_NAME', defaultValue: 'user-service', description: 'Kubernetes deployment/container name')
        string(name: 'SERVICE_IMAGE_TAG', defaultValue: 'user', description: 'Docker tag prefix used by CI, e.g. user, gateway, tracking')
        string(name: 'DOCKER_REPOSITORY', defaultValue: 'thelime1/tfakkarni', description: 'Docker Hub repository to deploy from')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Exact image tag produced by CI, e.g. user-123. Empty uses SERVICE_IMAGE_TAG latest tag')
        string(name: 'KUBE_NAMESPACE', defaultValue: 'tfakkarni', description: 'Kubernetes namespace')
        string(name: 'MANIFEST_BRANCH', defaultValue: 'agent', description: 'Git branch used only for manifests/scripts if checkout is needed')
        booleanParam(name: 'APPLY_MANIFESTS', defaultValue: true, description: 'Apply base manifests before setting image')
        booleanParam(name: 'WAIT_FOR_ROLLOUT', defaultValue: true, description: 'Wait for Kubernetes rollout')
    }

    environment { DOCKER_HUB_CREDS = credentials('dockerhub-credentials') }

    stages {
        stage('Resolve Image') {
            steps {
                script {
                    env.DEPLOY_TAG = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : params.SERVICE_IMAGE_TAG
                    env.DEPLOY_IMAGE = "${params.DOCKER_REPOSITORY}:${env.DEPLOY_TAG}"
                }
                echo "🚀 Preparing CD for ${params.SERVICE_NAME} with image ${env.DEPLOY_IMAGE}"
            }
        }

        stage('Checkout Manifests') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.MANIFEST_BRANCH}"]],
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [[$class: 'CloneOption', shallow: true, noTags: true, depth: 1, timeout: 30]]
                ])
                echo "✅ Manifests checked out from ${params.MANIFEST_BRANCH}"
            }
        }

        stage('Pull Image From Docker Hub') {
            steps {
                sh """
                    set +x
                    printf '%s' '${DOCKER_HUB_CREDS_PSW}' | docker login -u '${DOCKER_HUB_CREDS_USR}' --password-stdin
                    set -x
                    docker pull ${env.DEPLOY_IMAGE}
                """
                echo "✅ Docker Hub image is available locally: ${env.DEPLOY_IMAGE}"
            }
        }

        stage('Apply Kubernetes Base Manifests') {
            when { expression { return params.APPLY_MANIFESTS } }
            steps {
                sh """
                    kubectl apply -f k8s/00-namespace.yml
                    kubectl apply -f k8s/01-configmap.yml
                    kubectl apply -f k8s/02-secrets.yml
                    kubectl apply -f k8s/03-infrastructure.yml
                    kubectl apply -f k8s/04-microservices.yml
                    kubectl apply -f k8s/06-ingress.yml || true
                """
                echo "✅ Kubernetes base manifests applied"
            }
        }

        stage('Deploy Service Image') {
            steps {
                sh """
                    kubectl -n ${params.KUBE_NAMESPACE} set image deployment/${params.SERVICE_NAME} ${params.SERVICE_NAME}=${env.DEPLOY_IMAGE}
                    kubectl -n ${params.KUBE_NAMESPACE} annotate deployment/${params.SERVICE_NAME} \
                      tfakkarni.techhive/deployed-image='${env.DEPLOY_IMAGE}' \
                      tfakkarni.techhive/deployed-by='jenkins-cd' \
                      --overwrite
                """
                echo "✅ ${params.SERVICE_NAME} deployment updated to ${env.DEPLOY_IMAGE}"
            }
        }

        stage('Rollout Verification') {
            when { expression { return params.WAIT_FOR_ROLLOUT } }
            steps {
                sh """
                    kubectl -n ${params.KUBE_NAMESPACE} rollout status deployment/${params.SERVICE_NAME} --timeout=300s
                    kubectl -n ${params.KUBE_NAMESPACE} get deployment ${params.SERVICE_NAME} -o wide
                    kubectl -n ${params.KUBE_NAMESPACE} get pods -l app=${params.SERVICE_NAME} -o wide
                """
                echo "✅ Kubernetes rollout verified for ${params.SERVICE_NAME}"
            }
        }
    }

    post {
        success { echo "🎉 CD for ${params.SERVICE_NAME} deployed ${env.DEPLOY_IMAGE}" }
        failure { echo "❌ CD for ${params.SERVICE_NAME} failed while deploying ${env.DEPLOY_IMAGE}" }
        always { deleteDir() }
    }
}
