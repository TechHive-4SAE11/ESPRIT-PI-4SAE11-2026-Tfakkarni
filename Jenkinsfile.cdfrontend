// ============================================================
// Tfakkarni Frontend — CD Pipeline
// Angular 18 Application
// Déclenché sur: success CI + branche main
// ============================================================

pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'production'], description: 'Environment')
    }

    environment {
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "main"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                echo "✅ Code checked out from main"
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    sh "docker build -f frontend/Dockerfile -t ${baseRepo}:frontend -t ${baseRepo}:frontend-${env.BUILD_NUMBER} -t ${baseRepo}:frontend-${params.ENVIRONMENT} ."
                }
                echo '✅ Docker image built'
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    sh """
                        echo ${DOCKER_HUB_CREDS_PSW} | docker login -u ${DOCKER_HUB_CREDS_USR} --password-stdin
                        docker push ${baseRepo}:frontend
                        docker push ${baseRepo}:frontend-${env.BUILD_NUMBER}
                        docker push ${baseRepo}:frontend-${params.ENVIRONMENT}
                    """
                }
                echo '✅ Docker image pushed'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    if (params.ENVIRONMENT == 'dev') {
                        sh 'docker-compose -f docker-compose.frontend.dev.yml up -d --remove-orphans'
                    } else if (params.ENVIRONMENT == 'staging') {
                        sh 'docker-compose -f docker-compose.frontend.staging.yml up -d --remove-orphans'
                    } else {
                        sh 'docker-compose -f docker-compose.frontend.prod.yml up -d --remove-orphans'
                    }
                }
                echo "✅ Frontend deployed to ${params.ENVIRONMENT}"
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl --fail --retry 3 --retry-delay 5 http://localhost:4200'
                echo '✅ Health check passed'
            }
        }
    }

    post {
        success {
            echo '🎉 Frontend CD Pipeline completed successfully!'
        }
        failure {
            echo '❌ Frontend CD Pipeline failed. Check logs above.'
        }
        always {
            deleteDir()
        }
    }
}