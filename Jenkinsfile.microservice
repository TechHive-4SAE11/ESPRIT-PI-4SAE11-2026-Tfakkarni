pipeline {
    agent any

    tools {
        maven 'Maven-3.9'   // Configure in Jenkins > Global Tool Configuration
    }

    environment {
        // SERVICE_NAME is injected via Job DSL parameterized configuration.
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN      = credentials('sonar-token')
        SONAR_HOST       = 'http://sonarqube:9000'
        KUBE_NAMESPACE   = 'tfakkarni'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Code checked out from ${env.GIT_URL} branch ${env.GIT_BRANCH}"
            }
        }

        stage('Resolve Service Image Tag') {
            steps {
                script {
                    def imageTags = [
                        'discovery-service': 'discovery',
                        'config-service': 'config',
                        'api-gateway': 'gateway',
                        'user-service': 'user',
                        'game-service': 'game',
                        'tracking-service': 'tracking',
                        'alert-service': 'alert',
                        'ml-service': 'ml',
                        'medical-service': 'medical',
                        'medicament-validation-service': 'medicament-validation',
                        'iot-service': 'iot',
                        'assistant-service': 'assistant',
                        'analytics-service': 'analytics'
                    ]
                    if (!imageTags.containsKey(params.SERVICE_NAME)) {
                        error "Unsupported SERVICE_NAME '${params.SERVICE_NAME}'. Expected one of: ${imageTags.keySet().join(', ')}"
                    }
                    env.MODULE_TAG = imageTags[params.SERVICE_NAME]
                    env.IMAGE_REPO = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    env.BUILD_IMAGE = "${env.IMAGE_REPO}:${env.MODULE_TAG}-${env.BUILD_NUMBER}"
                    env.LATEST_IMAGE = "${env.IMAGE_REPO}:${env.MODULE_TAG}"
                    echo "Resolved ${params.SERVICE_NAME} -> ${env.BUILD_IMAGE}"
                }
            }
        }

        stage('Build & Test') {
            steps {
                echo "🏗️ Building isolated microservice: ${params.SERVICE_NAME}"
                dir('backend') {
                    withEnv(['SPRING_CLOUD_CONFIG_ENABLED=false', 'EUREKA_CLIENT_ENABLED=false', 'SPRING_PROFILES_ACTIVE=test']) {
                        sh "mvn clean package -pl ${params.SERVICE_NAME} -am -B"
                    }
                }
                echo "✅ Target JAR compiled"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "backend/${params.SERVICE_NAME}/target/surefire-reports/*.xml"
                    archiveArtifacts allowEmptyArchive: true, artifacts: "backend/${params.SERVICE_NAME}/target/site/jacoco/jacoco.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                          mvn sonar:sonar -pl ${params.SERVICE_NAME} -am -B \
                            -Dsonar.host.url=${SONAR_HOST} \
                            -Dsonar.token=${SONAR_TOKEN} \
                            -Dsonar.projectKey=tfakkarni-${params.SERVICE_NAME} \
                            -Dsonar.projectName='Tfakkarni ${params.SERVICE_NAME}' \
                            -Dsonar.coverage.jacoco.xmlReportPaths=${params.SERVICE_NAME}/target/site/jacoco/jacoco.xml
                        """
                    }
                }
                echo "✅ SonarQube component analysis pushed for ${params.SERVICE_NAME}"
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    sh 'echo "$DOCKER_HUB_CREDS_PSW" | docker login -u "$DOCKER_HUB_CREDS_USR" --password-stdin'
                    sh "docker build -t ${env.BUILD_IMAGE} -t ${env.LATEST_IMAGE} -f backend/${params.SERVICE_NAME}/Dockerfile backend/"
                    sh "docker push ${env.BUILD_IMAGE}"
                    sh "docker push ${env.LATEST_IMAGE}"
                }
                echo "✅ Docker images pushed to Docker Hub"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    sh "kubectl -n ${env.KUBE_NAMESPACE} set image deployment/${params.SERVICE_NAME} ${params.SERVICE_NAME}=${env.BUILD_IMAGE}"
                    sh "kubectl -n ${env.KUBE_NAMESPACE} rollout status deployment/${params.SERVICE_NAME} --timeout=180s"
                }
                echo "🚀 ${params.SERVICE_NAME} deployed to Kubernetes from Docker Hub image ${env.BUILD_IMAGE}"
            }
        }
    }

    post {
        success {
            echo "🎉 Microservice CI/CD Pipeline for ${params.SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "❌ Microservice CI/CD Pipeline for ${params.SERVICE_NAME} failed. Review Logs."
        }
        always {
            deleteDir()
        }
    }
}
