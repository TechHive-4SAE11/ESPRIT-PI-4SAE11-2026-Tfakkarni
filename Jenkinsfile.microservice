pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Git branch to build (e.g. main, develop, feature/xyz)')
    }

    tools {
        maven 'Maven-3.9'
    }

    environment {
        DOCKER_HUB_CREDS = credentials('dockerhub-credentials')
        SONAR_TOKEN      = credentials('sonar-token')
        SONAR_HOST       = 'http://sonarqube:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.BRANCH_NAME}"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
                echo "✅ Code checked out"
            }
        }

        // ⭐ NOUVEAU : Créer le fichier de test pour éviter les erreurs Keycloak
        stage('Prepare Test Config') {
            steps {
                script {
                    writeFile file: "backend/${params.SERVICE_NAME}/src/test/resources/application-test.yml", text: '''
spring:
  cloud:
    config:
      enabled: false
  autoconfigure:
    exclude:
      - org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration
      - org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration

eureka:
  client:
    enabled: false

keycloak:
  enabled: false
  server-url: http://localhost:8080
  realm: tfakkarni
  client-id: backend
  client-secret: dummy-secret
'''
                }
            }
        }

        stage('Build & Test') {
            steps {
                echo "🏗️ Building: ${params.SERVICE_NAME}"
                dir('backend') {
                    // ⭐ MODIFICATION : Ajout des propriétés pour désactiver Keycloak
                    sh """
                        mvn clean package -pl ${params.SERVICE_NAME} -am -B \
                          -DskipTests \
                          -Dspring.profiles.active=test \
                          -Dkeycloak.enabled=false \
                          -Dspring.cloud.config.enabled=false
                    """
                }
                echo "✅ Build completed"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "backend/${params.SERVICE_NAME}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh "mvn sonar:sonar -pl ${params.SERVICE_NAME} -am -Dsonar.host.url=${SONAR_HOST} -Dsonar.token=${SONAR_TOKEN} -B"
                    }
                }
                echo "✅ SonarQube done"
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    sh "docker login -u ${DOCKER_HUB_CREDS_USR} -p ${DOCKER_HUB_CREDS_PSW}"
                    
                    def moduleTag = params.DOCKER_IMAGE.replace('tfakkarni/', '')
                    def baseRepo = "${DOCKER_HUB_CREDS_USR}/tfakkarni"
                    
                    def buildImage = "${baseRepo}:${moduleTag}-${env.BUILD_NUMBER}"
                    def latestImage = "${baseRepo}:${moduleTag}"
                    
                    sh "docker build -t ${buildImage} -t ${latestImage} -f backend/${params.SERVICE_NAME}/Dockerfile backend/"
                    
                    sh "docker push ${buildImage}"
                    sh "docker push ${latestImage}"
                }
                echo "✅ Docker images pushed"
            }
        }

        stage('Deploy') {
            steps {
                script {
                    sh "docker-compose -f docker-compose.backend.yml up -d --no-deps ${params.SERVICE_NAME}"
                    sleep 5
                }
                echo "🚀 ${params.SERVICE_NAME} deployed"
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline for ${params.SERVICE_NAME} completed successfully!"
        }
        failure {
            echo "❌ Pipeline for ${params.SERVICE_NAME} failed. Review Logs."
        }
        always {
            deleteDir()
        }
    }
}