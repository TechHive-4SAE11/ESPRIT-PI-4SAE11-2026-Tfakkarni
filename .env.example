# ============================================================
# Tfakkarni — Docker environment variables
# Copy to .env and fill in your values
# ============================================================

# === PUBLIC ===
API_BASE_URL=http://localhost:9090
KEYCLOAK_URL=https://lemur-12.cloud-iam.com/auth

# === KEYCLOAK ADMIN ===
KEYCLOAK_ADMIN_PASSWORD=

# === NEON DATABASES ===
# Cluster 1: user-service
NEON_USER_DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_USER_DB_USERNAME=neondb_owner
NEON_USER_DB_PASSWORD=

# Cluster 2: game-service
NEON_GAME_DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_GAME_DB_USERNAME=neondb_owner
NEON_GAME_DB_PASSWORD=

# Cluster 3: tracking-service, alert-service, ml-service
NEON_SHARED_DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_SHARED_DB_USERNAME=neondb_owner
NEON_SHARED_DB_PASSWORD=
# medical-service uses different connection params on the same cluster
NEON_MEDICAL_DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&prepareThreshold=0

# Cluster 4: iot-service, analytics-service
NEON_IOT_DB_URL=jdbc:postgresql://HOST:5432/neondb?sslmode=require&channel_binding=require
NEON_IOT_DB_USERNAME=neondb_owner
NEON_IOT_DB_PASSWORD=

# === REDIS (Upstash) — used by alert-service, analytics-service ===
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# === MAILTRAP ===
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === DAILY.CO (video calls) ===
DAILY_API_KEY=

# === GROQ (LLM) ===
GROQ_TRACKING_API_KEY=
GROQ_ASSISTANT_API_KEY=

# === PEXELS ===
PEXELS_API_KEY=

# === ELEVENLABS ===
ELEVENLABS_API_KEY=
ELEVENLABS_TRACKING_API_KEY=

# === RECAPTCHA ===
RECAPTCHA_SECRET_KEY=

# === GOOGLE ===
GOOGLE_MAPS_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === TMDB ===
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# === ML SERVICE (AI + Twilio) ===
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
ML_TWILIO_SID=
ML_TWILIO_TOKEN=
ML_TWILIO_PHONE=
ML_TWILIO_WHATSAPP=
ML_DOCTOR_PHONE=

# === DIDIT KYC ===
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# === MISC ===
SAFETY_AUDIT_PRESENTATION_DEMO=false
